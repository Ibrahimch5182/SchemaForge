# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
.python-version.local

# uv
.uv-python/

# Environment / secrets
.env
.env.*

# Data: raw downloads, intermediate, processed artifacts, reports, caches
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Phase 5A: derived context-budgeted dataset prototype (reproducible via
# scripts/analyze_schema_context.py --write-derived; never the source of
# truth -- data/processed/*.jsonl remains Phase 1's untouched original)
data/processed_context_budgeted/*
!data/processed_context_budgeted/.gitkeep

# Phase 5A: candidate dataset (adaptive per-database compaction policy --
# reproducible via scripts/build_phase5_candidate.py; never the source of
# truth -- data/processed/*.jsonl remains Phase 1's untouched original)
data/processed_phase5_candidate/*
!data/processed_phase5_candidate/.gitkeep

# Phase 2: BIRD Mini-Dev benchmark workspace (downloaded databases, vendored
# evaluator, generated manifests/reports -- all reproducible via scripts)
data/benchmarks/bird_mini_dev/raw/*
!data/benchmarks/bird_mini_dev/raw/.gitkeep
data/benchmarks/bird_mini_dev/databases/*
!data/benchmarks/bird_mini_dev/databases/.gitkeep
data/benchmarks/bird_mini_dev/generation/*
!data/benchmarks/bird_mini_dev/generation/.gitkeep
data/benchmarks/bird_mini_dev/grading/*
!data/benchmarks/bird_mini_dev/grading/.gitkeep
data/benchmarks/bird_mini_dev/reports/*
!data/benchmarks/bird_mini_dev/reports/.gitkeep
data/benchmarks/bird_mini_dev/third_party/*
!data/benchmarks/bird_mini_dev/third_party/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Phase 3: baseline inference run artifacts (generations, predictions,
# summaries -- reproducible via scripts/run_baseline.py)
data/runs/*
!data/runs/.gitkeep

# Phase 5B: GPU/throughput certification datasets (reproducible via
# scripts/build_certification_sets.py from data/processed_phase5_candidate
# + the real Kaggle-tokenizer longest-examples manifest)
data/certification/*
!data/certification/.gitkeep

# Phase 5B: durable checkpoint exports (reproducible via
# scripts/export_checkpoint.py from a given run's checkpoint directory)
data/exports/*
!data/exports/.gitkeep

# Hugging Face / dataset caches
.cache/
.hf_cache/
huggingface/

# Databases
*.sqlite
*.sqlite3
*.db

# Model weights / checkpoints (future phases)
*.safetensors
*.bin
*.gguf
checkpoints/
/runs/
outputs/
wandb/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test / build artifacts
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
build/
dist/
