# Copy into the Vercel project's Environment Variables (Production), or export before `npm run build`.
# (Not named `.env.*`: the repo ignores those so real values are never committed.)
#
# Public HTTPS URL of the SchemaForge backend (the reverse proxy in front of FastAPI). REQUIRED for
# production builds; the build fails without it instead of falling back to localhost.
VITE_API_BASE_URL=https://api.example.com
# Optional client-side wait for a query. Keep it above SCHEMAFORGE_MODEL_TIMEOUT_SECONDS on the backend
# (CPU inference is slow) so the backend gives up first.
VITE_QUERY_TIMEOUT_MS=180000
