# Copy to `.env` next to docker-compose.yml on the host. Never commit the real file (.env is git-ignored).
# No secrets are required by the stack; do not add any to images.

# --- Public entry point -------------------------------------------------------------------------
# DNS name that resolves to the host's public IP. Free options: <elastic-ip-with-dashes>.sslip.io
# (e.g. 203-0-113-10.sslip.io), a DuckDNS subdomain, or your own domain.
SCHEMAFORGE_DOMAIN=api.example.com
# Exact https origin(s) of the frontend (Vercel production URL and/or custom domain), comma-separated.
# No wildcard: the backend refuses to start in production with "*", http:// or a loopback host here.
SCHEMAFORGE_CORS_ORIGINS=https://your-project.vercel.app

# --- Model artifacts (mounted read-only; never in the image or in Git) ---------------------------
MODEL_DIR=/opt/schemaforge/models
BASE_GGUF_NAME=base-Q4_K_M.gguf
LORA_GGUF_NAME=lora-1518-f16.gguf
# 1 = verify MODEL_DIR/SHA256SUMS at model-server start (recommended).
VERIFY_SHA256=1

# --- Serving ------------------------------------------------------------------------------------
# GPU layers to offload. 0 = CPU (default, zero-cost path). With the GPU overlay use e.g. 99.
LLAMA_NGL=0
# CPU threads; -1 = llama.cpp default. Set to the number of vCPUs on small hosts.
LLAMA_THREADS=-1
# Concurrent generations = model-server slots (each slot has a full 8192 context => more RAM).
# Keep 1 on CPU / small hosts.
LLAMA_PARALLEL=1
LLAMA_CTX=8192
# Backend per-request generation limit. CPU inference on a small host needs generous time.
MODEL_TIMEOUT_SECONDS=240

# --- Public-demo protection ---------------------------------------------------------------------
# Per-client POST /query limit per minute (0 disables).
RATE_LIMIT_PER_MINUTE=20

# --- Pinned images (defaults shown; change only deliberately) -----------------------------------
# LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b10964
# LLAMA_CPP_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10964
